# ── LeadSolar — Environment Variables ──────────────────────────────
# Copy to .env for local dev. On Railway/Cloud Run, set as service vars.

# ── Base URL (used in OG tags, onboarding guides, Stripe redirects) ──
BASE_URL=https://leadsolarinteligence.com.br

# ── AI / LLM ──
GEMINI_API_KEY=            # Google AI Studio — primary AI scoring
ANTHROPIC_API_KEY=         # Anthropic Claude — fallback AI scoring
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Google APIs ──
GOOGLE_MAPS_API_KEY=       # Maps + Solar API enabled
GOOGLE_CLOUD_PROJECT=      # GCP project ID (enables Firestore)
GOOGLE_APPLICATION_CREDENTIALS_JSON=  # Service account JSON (base64 or raw)

# ── Firebase Auth ──
FIREBASE_WEB_API_KEY=      # Firebase Web API key (for dashboard login)
FIREBASE_AUTH_DOMAIN=      # e.g. your-project.firebaseapp.com

# ── Stripe ──
STRIPE_SECRET_KEY=         # sk_live_...
STRIPE_WEBHOOK_SECRET=     # whsec_... (from Stripe Dashboard → Webhooks)

# ── Email (Resend) ──
RESEND_API_KEY=            # re_... from resend.com
NOTIFY_ADMIN_EMAIL=        # Admin email for hot-lead alerts
NOTIFY_FROM_EMAIL=leads@leadsolarinteligence.com.br

# ── Redis (optional, for rate limiting) ──
REDIS_URL=                 # redis://... (Railway Redis add-on or Upstash)

# ── CORS ──
CORS_ORIGINS=*             # Comma-separated origins or * for all

# ── Sentry (optional) ──
SENTRY_DSN=                # https://...@sentry.io/...

# ── Legacy (keep for backward compat) ──
API_KEYS=                  # JSON array of API keys, e.g. ["sk-ls-abc123"]
