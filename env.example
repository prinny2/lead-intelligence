# Copie para .env na raiz (não commite .env)
# cp env.example .env

# Obrigatório para POST /lead com IA (OpenAI: platform.openai.com — não use chaves Stripe sk_live_/sk_test_)
OPENAI_API_KEY=sk-...

# Onde gravar leads (JSONL). Em PaaS, use disco persistente ou path absoluto.
# Exemplo Render com disco: /data/leads.jsonl
# LEADS_FILE=/data/leads.jsonl

# CORS: origens permitidas, separadas por vírgula. Use * só em dev/testes.
# Ex.: https://meusite.com,https://www.meusite.com
# CORS_ORIGINS=*

# Chave de API para proteger os endpoints (opcional).
# Se definida, todas as requisições precisam do header: X-API-Key: <valor>
# Deixe em branco para modo aberto (dev/testes).
# API_KEY=sua_chave_secreta_aqui

# Porta (Railway/Render injetam PORT automaticamente)
# PORT=8000
