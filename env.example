# Copie para .env na raiz (não commite .env)
# cp env.example .env

# ─── OBRIGATÓRIO ──────────────────────────────────────────────────────────────

# Chave Anthropic Claude (scoring com IA)
# Obtenha em: https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── GOOGLE CLOUD / FIREBASE ──────────────────────────────────────────────────

# ID do projeto Firebase/GCP (ativa backend Firestore automaticamente)
# Projeto atual: lead-solar-12345
GOOGLE_CLOUD_PROJECT=lead-solar-12345

# ─── OPCIONAL ─────────────────────────────────────────────────────────────────

# Onde gravar leads em JSONL (fallback se Firestore não estiver configurado)
# Em PaaS com disco persistente use path absoluto: /data/leads.jsonl
# LEADS_FILE=/data/leads.jsonl

# CORS: origens permitidas, separadas por vírgula. Use * só em dev/testes.
# CORS_ORIGINS=https://lead-solar-12345.web.app,https://leadsolar.com.br

# Chave de API para proteger endpoints (opcional mas recomendado em produção)
# Se definida, todas as requisições precisam do header: X-API-Key: <valor>
# API_KEY=sua_chave_secreta_aqui

# Porta (Railway/Render/Cloud Run injetam PORT automaticamente)
# PORT=8080
